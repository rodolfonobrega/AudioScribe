{
  "name": "audioscribe-desktop",
  "version": "1.0.0",
  "description": "AudioScribe Desktop - Cross-platform Speech-to-Text with AI",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:linux": "electron-builder --linux --publish never"
  },
  "keywords": [
    "audio",
    "transcription",
    "speech-to-text",
    "ai",
    "groq",
    "whisper"
  ],
  "author": "AudioScribe Team",
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.audioscribe.desktop",
    "productName": "AudioScribe",
    "publish": {
      "provider": "github",
      "owner": "rodolfonobrega",
      "repo": "AudioScribe"
    },
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": ["AppImage", "tar.gz"],
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
